#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_BSLH         INT1              // (backslash)

&mt {
    flavor = "balanced";
    quick-tap-ms = <175>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        // 数字キー（左手）

        Num1 {
            bindings = <&num1_reset>;
            key-positions = <0 1>;  // Q+W
        };

        Num2 {
            bindings = <&num2_reset>;
            key-positions = <1 2>;  // W+E
        };

        Num3 {
            bindings = <&num3_reset>;
            key-positions = <2 3>;  // E+R
        };

        Num4 {
            bindings = <&num4_reset>;
            key-positions = <3 4>;  // R+T
        };

        Num5 {
            bindings = <&num5_reset>;
            key-positions = <13 14>;  // F+G
        };

        // 数字キー（右手）

        Num6 {
            bindings = <&num6_reset>;
            key-positions = <5 6>;  // Y+U
        };

        Num7 {
            bindings = <&num7_reset>;
            key-positions = <6 7>;  // U+I
        };

        Num8 {
            bindings = <&num8_reset>;
            key-positions = <7 8>;  // I+O
        };

        Num9 {
            bindings = <&num9_reset>;
            key-positions = <8 9>;  // O+P
        };

        Num0 {
            bindings = <&num0_reset>;
            key-positions = <19 20>;  // L+Enter
        };

        Layer_6 {
            bindings = <&mo 6>;
            key-positions = <21 22>;  // Z+X
        };

        PrtScr {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <0 9>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // 英数/かなキーをホールドして layer_2/layer_1 に入る瞬間に一回だけ
        // MOUSE レイヤー(5)を強制解除する。以降の連続数字入力は
        // このマクロを再実行しないので壊さない。
        mo_cancel_mouse: mo_cancel_mouse {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press &to 0>,
                <&macro_param_1to1 &macro_press &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1 &macro_release &mo MACRO_PLACEHOLDER>;
            label = "MO_CANCEL_MOUSE";
        };

        // 数字コンボ (mo1-mo9, mo0) はコンボ経由のため AML の
        // 「他キー押下で自動解除」の対象外になる。&to 0 を明示的に挟んで
        // MOUSE レイヤーを確実に解除してから数字/記号を出力する。
        num1_reset: num1_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo1>;
            label = "NUM1_RESET";
        };

        num2_reset: num2_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo2>;
            label = "NUM2_RESET";
        };

        num3_reset: num3_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo3>;
            label = "NUM3_RESET";
        };

        num4_reset: num4_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo4>;
            label = "NUM4_RESET";
        };

        num5_reset: num5_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo5>;
            label = "NUM5_RESET";
        };

        num6_reset: num6_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo6>;
            label = "NUM6_RESET";
        };

        num7_reset: num7_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo7>;
            label = "NUM7_RESET";
        };

        num8_reset: num8_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo8>;
            label = "NUM8_RESET";
        };

        num9_reset: num9_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo9>;
            label = "NUM9_RESET";
        };

        num0_reset: num0_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &mo0>;
            label = "NUM0_RESET";
        };

        bt_sel_0: bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
            label = "BT_SEL_0";
        };

        bt_sel_1: bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_DISC 0 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
            label = "BT_SEL_1";
        };

        bt_sel_2: bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 3 &bt BT_DISC 4>;
            label = "BT_SEL_2";
        };

        bt_sel_3: bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 4>;
            label = "BT_SEL_3";
        };

        bt_sel_4: bt_sel_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 4 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3>;
            label = "BT_SEL_4";
        };

        kakko_round: kakko_round {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT_ARROW>;
            label = "KAKKO_ROUND";
        };

        kakko_square: kakko_square {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET &kp JP_RBRACKET &kp LEFT_ARROW>;
            label = "KAKKO_SQUARE";
        };
    };

    behaviors {
        ctrl_a: ctrl_a {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_A";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 英数/かなキー用: ホールドで layer_2/layer_1 に入る際に MOUSE レイヤーを
        // 自動解除してから入る。タップは従来通り to_layer_0 でリセット。
        lt_cancel_mouse: lt_cancel_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_CANCEL_MOUSE";
            bindings = <&mo_cancel_mouse>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        mo1: mo1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>, <&kp EXCLAMATION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo2: mo2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2>, <&kp AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo3: mo3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_3>, <&kp POUND>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo4: mo4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4>, <&kp DOLLAR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo5: mo5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_5>, <&kp PERCENT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo6: mo6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&kp CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo7: mo7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_7>, <&kp AMPERSAND>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo8: mo8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_8>, <&kp ASTERISK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo9: mo9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_9>, <&kp LEFT_PARENTHESIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo0: mo0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0>, <&kp LS(NUMBER_9)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moA: moA {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moB: moB {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moC: moC {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT3>, <&kp JP_PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moD: moD {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moE: moE {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moF: moF {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp JP_PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moG: moG {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp APOSTROPHE>, <&kp DOUBLE_QUOTES>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        moH: moH {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp TILDE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |                      |  Y  |  U  |  I  |  O  |  P  |
            // |A/CTL|  S  |  D  |  F  |  G  |                | ,/< |  H  |  J  |  K  |  L  | ENT |
            // |Z/SFT|  X  |  C  |  V  |  B  | //? |          | ./> |  N  |  M  | MB1 | MB2 | SFT |
            // | CTRL| WIN | ALT | DEL |英数L2|SPACE|          |SPACE|かなL1|                | BKS |

            bindings = <
&kp Q             &kp W         &kp E         &kp R       &kp T                                      &kp Y          &kp U  &kp I       &kp O      &kp P
&ctrl_a LCTRL A   &kp S         &kp D         &kp F       &kp G                       &kakko_square  &kp H          &kp J  &kp K       &kp L      &kp ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V       &kp B          &kp SLASH    &kakko_round   &kp N          &kp M  &kp COMMA   &kp PERIOD  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &lt_cancel_mouse 2 JP_EISU  &kp SPACE    &kp SPACE      &lt_cancel_mouse 1 JP_KANA                                &kp BACKSPACE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            // -----------------------------------------------------------------------------------
            // | F1  | F2  | F3  | F4  | F5  |                      |trans|trans| -/_ | =/+ |¥/| |
            // | F6  | F7  | F8  | F9  | F10 |                |trans|trans|trans|trans| @/` | [/{ |
            // |SHIFT|trans|trans|trans| F11 | F12 |          |trans|trans|trans| ;/+ | :/' | ]/} |
            // | CTRL| WIN | ALT | DEL | 英数 |SPACE|          |SPACE| かな |                |  _  |

            bindings = <
&kp F1          &kp F2        &kp F3        &kp F4      &kp F5                               &trans       &trans  &moA    &moB  &moC
&kp F6          &kp F7        &kp F8        &kp F9      &kp F10                   &trans     &trans       &trans  &trans  &moD  &moE
&kp LEFT_SHIFT  &trans        &trans        &trans      &kp F11      &kp F12      &trans     &trans       &trans  &moF    &moG  &moH
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &kp JP_EISU  &kp SPACE    &kp SPACE  &kp JP_KANA                        &kp JP_UNDERSCORE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            // -----------------------------------------------------------------------------------
            // | 1/! | 2/" | 3/# | 4/$ | 5/% |                      | 6/& | 7/' | 8/( | 9/) | 0/) |
            // |trans|trans|trans|trans|trans|                |trans|trans|trans|  ↑  |trans|trans|
            // |SHIFT|trans|trans|trans|trans|trans|          |trans|trans|  ←  |  ↓  |  →  |SHIFT|
            // | CTRL| WIN | ALT | DEL | 英数 |SPACE|          |SPACE| かな |                |  _  |

            bindings = <
&mo1            &mo2          &mo3          &mo4        &mo5                                 &mo6         &mo7            &mo8            &mo9             &mo0
&trans          &trans        &trans        &trans      &trans                    &trans     &trans       &trans          &kp UP_ARROW    &trans           &trans
&kp LEFT_SHIFT  &trans        &trans        &trans      &trans       &trans       &trans     &trans       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &kp JP_EISU  &kp SPACE    &kp SPACE  &kp JP_KANA                                                   &kp JP_UNDERSCORE
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_3 {
            // -----------------------------------------------------------------------------------
            // |trans|trans|trans|trans|trans|                      |trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|                |trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|                |trans|

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        layer_4 {
            // -----------------------------------------------------------------------------------
            // |trans|trans|trans|trans|trans|                      |trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|                |trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|                |trans|

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        MOUSE {
            // -----------------------------------------------------------------------------------
            // |trans|trans|trans|trans|trans|                      |trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|                |trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|trans| MB1 | MB2 |trans|
            // |trans|trans|trans|trans|trans|trans|          |trans|trans|                |trans|

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            // -----------------------------------------------------------------------------------
            // |STUD |RESET|trans|trans|trans|                      |trans|trans|trans| BT3 | BT0 |
            // |trans|trans|trans|trans|trans|                |trans|trans|trans|trans| BT4 | BT1 |
            // |SHIFT|trans|trans|trans|trans|trans|          |trans|trans|trans|trans|trans| BT2 |
            // | CTRL| WIN | ALT | DEL | 英数 |SPACE|          |SPACE| かな |                |BTCLR|

            bindings = <
&studio_unlock  &sys_reset    &trans        &trans      &trans                               &trans       &trans  &trans  &bt_sel_3  &bt_sel_0
&trans          &trans        &trans        &trans      &trans                    &trans     &trans       &trans  &trans  &bt_sel_4  &bt_sel_1
&kp LEFT_SHIFT  &trans        &trans        &trans      &trans       &trans       &trans     &trans       &trans  &trans  &trans        &bt_sel_2
&kp LCTRL       &kp LEFT_WIN  &kp LEFT_ALT  &kp DELETE  &kp JP_EISU  &kp SPACE    &kp SPACE  &kp JP_KANA                                &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_right_left>;
        };
    };
};
